<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SheepSheep Burger ERP System</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif; background: #f0f2f5; color: #333; }

/* Login Page */
#loginPage { display: flex; justify-content: center; align-items: center; min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.login-box { background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); width: 380px; }
.login-box h1 { text-align: center; color: #764ba2; margin-bottom: 8px; font-size: 24px; }
.login-box .subtitle { text-align: center; color: #999; margin-bottom: 30px; font-size: 14px; }
.login-box input { width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; }
.login-box button { width: 100%; padding: 12px; background: #764ba2; color: #fff; border: none; border-radius: 6px; font-size: 16px; cursor: pointer; margin-top: 16px; }
.login-box button:hover { background: #667eea; }
.role-demo { margin-top: 20px; padding: 12px; background: #f5f5f5; border-radius: 6px; font-size: 12px; line-height: 1.8; }
.role-demo b { color: #764ba2; }

/* Main Layout */
#mainApp { display: none; }
.sidebar { width: 220px; background: #2c3e50; color: #fff; position: fixed; top: 0; left: 0; bottom: 0; padding-top: 20px; overflow-y: auto; }
.sidebar .logo { text-align: center; font-size: 18px; font-weight: bold; padding: 20px 0; border-bottom: 1px solid #34495e; margin-bottom: 20px; }
.sidebar .logo span { color: #e74c3c; }
.sidebar a { display: block; color: #bdc3c7; padding: 12px 24px; text-decoration: none; font-size: 14px; transition: all 0.3s; }
.sidebar a:hover, .sidebar a.active { background: #34495e; color: #fff; border-left: 3px solid #e74c3c; }
.sidebar a .icon { margin-right: 10px; }
.sidebar .user-info { position: absolute; bottom: 20px; left: 0; right: 0; padding: 16px 24px; border-top: 1px solid #34495e; font-size: 12px; }

.main-content { margin-left: 220px; padding: 24px; }
.top-bar { background: #fff; padding: 16px 24px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.top-bar h2 { font-size: 20px; color: #2c3e50; }
.top-bar .logout { color: #e74c3c; cursor: pointer; font-size: 14px; }

/* Cards */
.card-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px; }
.stat-card { background: #fff; padding: 24px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.stat-card .label { font-size: 13px; color: #999; margin-bottom: 8px; }
.stat-card .value { font-size: 28px; font-weight: bold; color: #2c3e50; }
.stat-card .change { font-size: 12px; margin-top: 8px; }
.stat-card .change.up { color: #27ae60; }
.stat-card .change.down { color: #e74c3c; }
.stat-card.bg-blue { border-top: 4px solid #3498db; }
.stat-card.bg-green { border-top: 4px solid #27ae60; }
.stat-card.bg-orange { border-top: 4px solid #f39c12; }
.stat-card.bg-red { border-top: 4px solid #e74c3c; }

/* Tables */
.table-container { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); overflow: hidden; }
.table-header { padding: 16px 24px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
.table-header h3 { font-size: 16px; color: #2c3e50; }
.btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 13px; }
.btn-primary { background: #3498db; color: #fff; }
.btn-success { background: #27ae60; color: #fff; }
.btn-warning { background: #f39c12; color: #fff; }
.btn-danger { background: #e74c3c; color: #fff; }
.btn-sm { padding: 4px 10px; font-size: 12px; }

table { width: 100%; border-collapse: collapse; }
th, td { padding: 12px 16px; text-align: left; border-bottom: 1px solid #eee; font-size: 13px; }
th { background: #f8f9fa; font-weight: 600; color: #2c3e50; }
tr:hover { background: #f8f9fa; }

/* Badges */
.badge { padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 500; }
.badge-pending { background: #fff3cd; color: #856404; }
.badge-processing { background: #cce5ff; color: #004085; }
.badge-completed { background: #d4edda; color: #155724; }
.badge-cancelled { background: #f8d7da; color: #721c24; }
.badge-low { background: #f8d7da; color: #721c24; }
.badge-ok { background: #d4edda; color: #155724; }

/* Modal */
.modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; }
.modal-overlay.show { display: flex; }
.modal { background: #fff; border-radius: 8px; width: 500px; max-height: 80vh; overflow-y: auto; padding: 24px; }
.modal h3 { margin-bottom: 20px; color: #2c3e50; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; margin-bottom: 6px; font-size: 13px; color: #555; }
.form-group input, .form-group select, .form-group textarea { width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; }
.modal-footer { margin-top: 20px; text-align: right; }
.modal-footer button { margin-left: 8px; }

/* Section */
.section { display: none; }
.section.active { display: block; }

/* Alert */
.alert { padding: 12px 16px; border-radius: 4px; margin-bottom: 16px; font-size: 13px; }
.alert-warning { background: #fff3cd; color: #856404; border: 1px solid #ffeaa7; }
.alert-danger { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
.alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }

/* Charts placeholder */
.chart-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
.chart-box { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.chart-box h4 { font-size: 14px; color: #2c3e50; margin-bottom: 16px; }
.bar-chart { display: flex; align-items: flex-end; height: 160px; gap: 12px; padding: 0 10px; }
.bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.bar { width: 100%; border-radius: 4px 4px 0 0; transition: height 0.3s; min-height: 4px; }
.bar-label { font-size: 11px; color: #999; margin-top: 6px; }
.bar-value { font-size: 11px; color: #333; margin-bottom: 4px; font-weight: 600; }
</style>
</head>
<body>

<!-- Login Page -->
<div id="loginPage">
  <div class="login-box">
    <h1>🍔 SheepSheep Burger</h1>
    <p class="subtitle">ERP Management System</p>
    <input type="text" id="loginUser" placeholder="Username" value="admin">
    <input type="password" id="loginPass" placeholder="Password" value="admin123">
    <button onclick="login()">Login</button>
    <div class="role-demo">
      <b>Demo Accounts:</b><br>
      admin / admin123 (Admin)<br>
      manager / manager123 (Store Manager)<br>
      kitchen / kitchen123 (Kitchen)<br>
      finance / finance123 (Finance)
    </div>
  </div>
</div>

<!-- Main App -->
<div id="mainApp">
  <div class="sidebar">
    <div class="logo">🐑 SheepSheep<span> Burger</span></div>
    <a href="#" class="nav-link active" data-section="dashboard" onclick="showSection('dashboard')"><span class="icon">📊</span>Dashboard</a>
    <a href="#" class="nav-link" data-section="sd" onclick="showSection('sd')"><span class="icon">🛒</span>Sales (SD)</a>
    <a href="#" class="nav-link" data-section="pp" onclick="showSection('pp')"><span class="icon">👨‍🍳</span>Production (PP)</a>
    <a href="#" class="nav-link" data-section="mm" onclick="showSection('mm')"><span class="icon">📦</span>Inventory (MM)</a>
    <a href="#" class="nav-link" data-section="fi" onclick="showSection('fi')"><span class="icon">💰</span>Finance (FI)</a>
    <a href="#" class="nav-link" data-section="co" onclick="showSection('co')"><span class="icon">📈</span>Cost (CO)</a>
    <a href="#" class="nav-link" data-section="hcm" onclick="showSection('hcm')"><span class="icon">👥</span>HR (HCM)</a>
    <div class="user-info">
      <div id="currentUser">Admin</div>
      <div id="currentRole" style="color:#7f8c8d">Administrator</div>
    </div>
  </div>

  <div class="main-content">
    <div class="top-bar">
      <h2 id="pageTitle">Dashboard</h2>
      <span class="logout" onclick="logout()">Logout →</span>
    </div>

    <!-- Dashboard -->
    <div id="section-dashboard" class="section active">
      <div class="card-grid">
        <div class="stat-card bg-blue">
          <div class="label">Today's Revenue</div>
          <div class="value" id="statRevenue">$2,480</div>
          <div class="change up">↑ 12.5% vs yesterday</div>
        </div>
        <div class="stat-card bg-green">
          <div class="label">Pending Orders</div>
          <div class="value" id="statPendingOrders">8</div>
          <div class="change">Orders waiting production</div>
        </div>
        <div class="stat-card bg-orange">
          <div class="label">Low Stock Items</div>
          <div class="value" id="statLowStock">3</div>
          <div class="change down">↓ Need procurement</div>
        </div>
        <div class="stat-card bg-red">
          <div class="label">Monthly Cost</div>
          <div class="value" id="statMonthlyCost">$8,920</div>
          <div class="change up">↑ 5.2% this month</div>
        </div>
      </div>

      <div class="chart-row">
        <div class="chart-box">
          <h4>Last 7 Days Sales ($)</h4>
          <div class="bar-chart" id="salesChart"></div>
        </div>
        <div class="chart-box">
          <h4>Burger Type Profit Margin</h4>
          <div class="bar-chart" id="profitChart"></div>
        </div>
      </div>

      <div class="table-container">
        <div class="table-header">
          <h3>Recent Orders</h3>
        </div>
        <table>
          <thead>
            <tr><th>Order ID</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr>
          </thead>
          <tbody id="recentOrdersBody"></tbody>
        </table>
      </div>
    </div>

    <!-- SD: Sales -->
    <div id="section-sd" class="section">
      <div id="sdAlert"></div>
      <div class="table-container">
        <div class="table-header">
          <h3>Sales Orders (SD)</h3>
          <button class="btn btn-primary" onclick="openOrderModal()">+ New Order</button>
        </div>
        <table>
          <thead>
            <tr><th>Order ID</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Action</th></tr>
          </thead>
          <tbody id="ordersBody"></tbody>
        </table>
      </div>
    </div>

    <!-- PP: Production -->
    <div id="section-pp" class="section">
      <div id="ppAlert"></div>
      <div class="table-container">
        <div class="table-header">
          <h3>Production Orders (PP)</h3>
          <button class="btn btn-primary" onclick="createProductionFromOrders()">Generate Production from Orders</button>
        </div>
        <table>
          <thead>
            <tr><th>Prod ID</th><th>Burger Type</th><th>Qty</th><th>Status</th><th>Material Check</th><th>Action</th></tr>
          </thead>
          <tbody id="productionBody"></tbody>
        </table>
      </div>
      <br>
      <div class="table-container">
        <div class="table-header">
          <h3>BOM (Bill of Materials)</h3>
        </div>
        <table>
          <thead>
            <tr><th>Burger</th><th>Bun</th><th>Patty</th><th>Vegetable</th><th>Sauce</th></tr>
          </thead>
          <tbody>
            <tr><td>Classic Burger</td><td>1</td><td>1</td><td>50g</td><td>20g</td></tr>
            <tr><td>Cheese Burger</td><td>1</td><td>1</td><td>50g</td><td>20g</td></tr>
            <tr><td>Double Burger</td><td>1</td><td>2</td><td>80g</td><td>30g</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- MM: Inventory -->
    <div id="section-mm" class="section">
      <div id="mmAlert"></div>
      <div class="card-grid" style="grid-template-columns: repeat(3,1fr)">
        <div class="stat-card bg-blue"><div class="label">Total Materials</div><div class="value" id="statMatCount">6</div></div>
        <div class="stat-card bg-orange"><div class="label">Low Stock Items</div><div class="value" id="statLowMat">3</div></div>
        <div class="stat-card bg-green"><div class="label">Open Purchase Orders</div><div class="value" id="statPOCount">2</div></div>
      </div>
      <div class="table-container">
        <div class="table-header">
          <h3>Material Inventory</h3>
          <button class="btn btn-primary" onclick="openProcurementModal()">+ New Procurement</button>
        </div>
        <table>
          <thead>
            <tr><th>Material</th><th>Unit</th><th>In Stock</th><th>Reorder Point</th><th>Status</th><th>Unit Price</th></tr>
          </thead>
          <tbody id="inventoryBody"></tbody>
        </table>
      </div>
      <br>
      <div class="table-container">
        <div class="table-header">
          <h3>Purchase Orders</h3>
        </div>
        <table>
          <thead>
            <tr><th>PO ID</th><th>Supplier</th><th>Items</th><th>Total</th><th>Status</th><th>Action</th></tr>
          </thead>
          <tbody id="purchaseBody"></tbody>
        </table>
      </div>
    </div>

    <!-- FI: Finance -->
    <div id="section-fi" class="section">
      <div class="card-grid" style="grid-template-columns: repeat(3,1fr)">
        <div class="stat-card bg-green"><div class="label">Accounts Receivable</div><div class="value">$3,240</div></div>
        <div class="stat-card bg-red"><div class="label">Accounts Payable</div><div class="value">$1,860</div></div>
        <div class="stat-card bg-blue"><div class="label">Net Cash Flow</div><div class="value">$1,380</div></div>
      </div>
      <div class="table-container">
        <div class="table-header">
          <h3>Payment Approvals</h3>
        </div>
        <table>
          <thead>
            <tr><th>Invoice ID</th><th>Type</th><th>Party</th><th>Amount</th><th>Status</th><th>Action</th></tr>
          </thead>
          <tbody id="invoiceBody"></tbody>
        </table>
      </div>
    </div>

    <!-- CO: Cost -->
    <div id="section-co" class="section">
      <div class="table-container">
        <div class="table-header">
          <h3>Product Cost Analysis (CO)</h3>
        </div>
        <table>
          <thead>
            <tr><th>Burger Type</th><th>Selling Price</th><th>Material Cost</th><th>Labor Cost</th><th>Overhead</th><th>Total Cost</th><th>Profit/Unit</th><th>Margin</th></tr>
          </thead>
          <tbody id="costBody"></tbody>
        </table>
      </div>
    </div>

    <!-- HCM: HR -->
    <div id="section-hcm" class="section">
      <div class="table-container">
        <div class="table-header">
          <h3>Employee Roster (HCM)</h3>
          <button class="btn btn-primary" onclick="alert('Add employee form - demo')">+ Add Employee</button>
        </div>
        <table>
          <thead>
            <tr><th>ID</th><th>Name</th><th>Role</th><th>Department</th><th>Hourly Wage</th><th>Monthly Hours</th><th>Status</th></tr>
          </thead>
          <tbody id="employeeBody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Order Modal -->
<div class="modal-overlay" id="orderModal">
  <div class="modal">
    <h3>Create New Sales Order</h3>
    <div class="form-group">
      <label>Customer Name</label>
      <input type="text" id="ordCustomer" placeholder="e.g. Walk-in Customer">
    </div>
    <div class="form-group">
      <label>Channel</label>
      <select id="ordChannel">
        <option>Dine-in</option>
        <option>Takeaway</option>
        <option>Delivery Platform</option>
      </select>
    </div>
    <div class="form-group">
      <label>Classic Burger (Qty)</label>
      <input type="number" id="ordClassic" value="1" min="0">
    </div>
    <div class="form-group">
      <label>Cheese Burger (Qty)</label>
      <input type="number" id="ordCheese" value="0" min="0">
    </div>
    <div class="form-group">
      <label>Double Burger (Qty)</label>
      <input type="number" id="ordDouble" value="0" min="0">
    </div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModal('orderModal')">Cancel</button>
      <button class="btn btn-primary" onclick="createOrder()">Submit Order</button>
    </div>
  </div>
</div>

<!-- Procurement Modal -->
<div class="modal-overlay" id="procModal">
  <div class="modal">
    <h3>Create Procurement Order</h3>
    <div class="form-group">
      <label>Supplier</label>
      <select id="procSupplier">
        <option>Fresh Foods Co.</option>
        <option>Bakery Direct</option>
        <option>Meat Supply Ltd.</option>
      </select>
    </div>
    <div class="form-group">
      <label>Material</label>
      <select id="procMaterial">
        <option value="Bun">Bun</option>
        <option value="Patty">Patty</option>
        <option value="Vegetable">Vegetable</option>
        <option value="Sauce">Sauce</option>
      </select>
    </div>
    <div class="form-group">
      <label>Quantity</label>
      <input type="number" id="procQty" value="100" min="1">
    </div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModal('procModal')">Cancel</button>
      <button class="btn btn-primary" onclick="createProcurement()">Create PO</button>
    </div>
  </div>
</div>

<script>
// ============ Data Layer (localStorage) ============
const DB_KEY = 'sheepsheep_erp_db';

function getDB() {
  let db = localStorage.getItem(DB_KEY);
  if (!db) {
    db = {
      users: [
        { username: 'admin', password: 'admin123', role: 'Administrator', name: 'Admin' },
        { username: 'manager', password: 'manager123', role: 'Store Manager', name: 'Manager Li' },
        { username: 'kitchen', password: 'kitchen123', role: 'Kitchen Staff', name: 'Chef Wang' },
        { username: 'finance', password: 'finance123', role: 'Finance', name: 'Accountant Zhang' }
      ],
      orders: [
        { id: 'ORD-001', customer: 'Walk-in Customer', channel: 'Dine-in', items: { classic: 2, cheese: 1, double: 0 }, total: 28.5, status: 'completed', date: '2026-10-12' },
        { id: 'ORD-002', customer: 'Meituan Delivery', channel: 'Delivery Platform', items: { classic: 1, cheese: 2, double: 1 }, total: 42.0, status: 'processing', date: '2026-10-12' },
        { id: 'ORD-003', customer: 'Office Group', channel: 'Takeaway', items: { classic: 5, cheese: 3, double: 2 }, total: 95.5, status: 'pending', date: '2026-10-12' }
      ],
      production: [
        { id: 'PROD-001', burger: 'Classic Burger', qty: 2, status: 'completed', materialCheck: 'ok' },
        { id: 'PROD-002', burger: 'Cheese Burger', qty: 3, status: 'processing', materialCheck: 'ok' },
        { id: 'PROD-003', burger: 'Double Burger', qty: 2, status: 'pending', materialCheck: 'low' }
      ],
      inventory: [
        { name: 'Bun', unit: 'pcs', stock: 45, reorder: 50, price: 0.30 },
        { name: 'Patty', unit: 'pcs', stock: 120, reorder: 80, price: 1.20 },
        { name: 'Vegetable', unit: 'kg', stock: 8, reorder: 10, price: 2.50 },
        { name: 'Sauce', unit: 'kg', stock: 15, reorder: 8, price: 4.00 },
        { name: 'Cheese', unit: 'pcs', stock: 30, reorder: 40, price: 0.80 },
        { name: 'Drink Cup', unit: 'pcs', stock: 200, reorder: 100, price: 0.15 }
      ],
      purchaseOrders: [
        { id: 'PO-001', supplier: 'Bakery Direct', items: 'Bun x 200', total: 60.0, status: 'pending' },
        { id: 'PO-002', supplier: 'Fresh Foods Co.', items: 'Vegetable x 15kg', total: 37.5, status: 'approved' }
      ],
      invoices: [
        { id: 'INV-001', type: 'Payable', party: 'Bakery Direct', amount: 60.0, status: 'pending' },
        { id: 'INV-002', type: 'Receivable', party: 'Meituan Delivery', amount: 42.0, status: 'approved' },
        { id: 'INV-003', type: 'Payable', party: 'Meat Supply Ltd.', amount: 144.0, status: 'approved' }
      ],
      employees: [
        { id: 'E001', name: 'Manager Li', role: 'Store Manager', dept: 'Management', wage: 25, hours: 176, status: 'Active' },
        { id: 'E002', name: 'Chef Wang', role: 'Head Chef', dept: 'Kitchen', wage: 18, hours: 200, status: 'Active' },
        { id: 'E003', name: 'Cook Liu', role: 'Cook', dept: 'Kitchen', wage: 14, hours: 200, status: 'Active' },
        { id: 'E004', name: 'Cashier Zhao', role: 'Cashier', dept: 'Front of House', wage: 12, hours: 168, status: 'Active' },
        { id: 'E005', name: 'Delivery Sun', role: 'Delivery Rider', dept: 'Delivery', wage: 10, hours: 180, status: 'Active' },
        { id: 'E006', name: 'Accountant Zhang', role: 'Accountant', dept: 'Finance', wage: 20, hours: 160, status: 'Active' }
      ],
      nextOrderId: 4,
      nextProdId: 4,
      nextPOId: 3
    };
    localStorage.setItem(DB_KEY, JSON.stringify(db));
  }
  return JSON.parse(db);
}

function saveDB(db) {
  localStorage.setItem(DB_KEY, JSON.stringify(db));
}

// ============ Auth ============
let currentUser = null;

function login() {
  const u = document.getElementById('loginUser').value;
  const p = document.getElementById('loginPass').value;
  const db = getDB();
  const user = db.users.find(x => x.username === u && x.password === p);
  if (user) {
    currentUser = user;
    document.getElementById('currentUser').textContent = user.name;
    document.getElementById('currentRole').textContent = user.role;
    document.getElementById('loginPage').style.display = 'none';
    document.getElementById('mainApp').style.display = 'block';
    renderAll();
  } else {
    alert('Invalid username or password!');
  }
}

function logout() {
  currentUser = null;
  document.getElementById('mainApp').style.display = 'none';
  document.getElementById('loginPage').style.display = 'flex';
}

// ============ Navigation ============
function showSection(name) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.getElementById('section-' + name).classList.add('active');
  document.querySelectorAll('.nav-link').forEach(a => a.classList.remove('active'));
  document.querySelector(`.nav-link[data-section="${name}"]`).classList.add('active');
  const titles = {
    dashboard: 'Dashboard', sd: 'Sales & Distribution (SD)', pp: 'Production Planning (PP)',
    mm: 'Materials Management (MM)', fi: 'Financial Accounting (FI)',
    co: 'Controlling (CO)', hcm: 'Human Capital Management (HCM)'
  };
  document.getElementById('pageTitle').textContent = titles[name] || name;
}

// ============ Rendering ============
function renderAll() {
  renderDashboard();
  renderOrders();
  renderProduction();
  renderInventory();
  renderPurchase();
  renderInvoices();
  renderCost();
  renderEmployees();
}

function renderDashboard() {
  const db = getDB();
  const todayOrders = db.orders.filter(o => o.status !== 'cancelled');
  const revenue = todayOrders.reduce((s, o) => s + o.total, 0);
  const pending = db.orders.filter(o => o.status === 'pending').length;
  const lowStock = db.inventory.filter(i => i.stock < i.reorder).length;
  document.getElementById('statRevenue').textContent = '$' + revenue.toFixed(0);
  document.getElementById('statPendingOrders').textContent = pending;
  document.getElementById('statLowStock').textContent = lowStock;

  // Recent orders
  document.getElementById('recentOrdersBody').innerHTML = db.orders.slice(0, 5).map(o => `
    <tr><td>${o.id}</td><td>${o.customer}</td><td>${formatItems(o.items)}</td><td>$${o.total.toFixed(2)}</td><td>${statusBadge(o.status)}</td></tr>
  `).join('');

  // Sales chart
  const salesData = [1850, 2100, 1980, 2350, 2600, 2200, revenue];
  const maxS = Math.max(...salesData);
  document.getElementById('salesChart').innerHTML = salesData.map((v, i) => `
    <div class="bar-item">
      <div class="bar-value">$${v}</div>
      <div class="bar" style="height:${(v/maxS)*140}px;background:#3498db"></div>
      <div class="bar-label">D${i+1}</div>
    </div>
  `).join('');

  // Profit chart
  const profitData = [55, 62, 48];
  const labels = ['Classic', 'Cheese', 'Double'];
  document.getElementById('profitChart').innerHTML = profitData.map((v, i) => `
    <div class="bar-item">
      <div class="bar-value">${v}%</div>
      <div class="bar" style="height:${(v/70)*140}px;background:#27ae60"></div>
      <div class="bar-label">${labels[i]}</div>
    </div>
  `).join('');
}

function renderOrders() {
  const db = getDB();
  document.getElementById('ordersBody').innerHTML = db.orders.map(o => `
    <tr>
      <td>${o.id}</td><td>${o.customer}<br><small style="color:#999">${o.channel}</small></td>
      <td>${formatItems(o.items)}</td>
      <td>$${o.total.toFixed(2)}</td>
      <td>${statusBadge(o.status)}</td>
      <td>
        ${o.status === 'pending' ? `<button class="btn btn-sm btn-success" onclick="approveOrder('${o.id}')">Approve</button>` : ''}
        ${o.status === 'processing' ? `<button class="btn btn-sm btn-primary" onclick="completeOrder('${o.id}')">Complete</button>` : ''}
      </td>
    </tr>
  `).join('');
}

function renderProduction() {
  const db = getDB();
  document.getElementById('productionBody').innerHTML = db.production.map(p => `
    <tr>
      <td>${p.id}</td><td>${p.burger}</td><td>${p.qty}</td>
      <td>${statusBadge(p.status)}</td>
      <td>${p.materialCheck === 'ok' ? '<span class="badge badge-ok">Sufficient</span>' : '<span class="badge badge-low">Low Stock</span>'}</td>
      <td>
        ${p.status === 'pending' ? `<button class="btn btn-sm btn-primary" onclick="startProduction('${p.id}')">Start</button>` : ''}
        ${p.status === 'processing' ? `<button class="btn btn-sm btn-success" onclick="finishProduction('${p.id}')">Finish</button>` : ''}
      </td>
    </tr>
  `).join('');
}

function renderInventory() {
  const db = getDB();
  document.getElementById('inventoryBody').innerHTML = db.inventory.map(i => `
    <tr>
      <td>${i.name}</td><td>${i.unit}</td><td>${i.stock}</td><td>${i.reorder}</td>
      <td>${i.stock < i.reorder ? '<span class="badge badge-low">Low</span>' : '<span class="badge badge-ok">OK</span>'}</td>
      <td>$${i.price.toFixed(2)}</td>
    </tr>
  `).join('');
  const low = db.inventory.filter(i => i.stock < i.reorder).length;
  document.getElementById('statLowMat').textContent = low;
  document.getElementById('statPOCount').textContent = db.purchaseOrders.filter(p => p.status === 'pending').length;
}

function renderPurchase() {
  const db = getDB();
  document.getElementById('purchaseBody').innerHTML = db.purchaseOrders.map(p => `
    <tr>
      <td>${p.id}</td><td>${p.supplier}</td><td>${p.items}</td>
      <td>$${p.total.toFixed(2)}</td><td>${statusBadge(p.status)}</td>
      <td>
        ${p.status === 'approved' ? `<button class="btn btn-sm btn-success" onclick="receiveGoods('${p.id}')">Goods Receipt</button>` : ''}
      </td>
    </tr>
  `).join('');
}

function renderInvoices() {
  const db = getDB();
  document.getElementById('invoiceBody').innerHTML = db.invoices.map(inv => `
    <tr>
      <td>${inv.id}</td><td>${inv.type}</td><td>${inv.party}</td>
      <td>$${inv.amount.toFixed(2)}</td><td>${statusBadge(inv.status)}</td>
      <td>
        ${inv.status === 'pending' ? `<button class="btn btn-sm btn-success" onclick="approveInvoice('${inv.id}')">Approve</button>
        <button class="btn btn-sm btn-danger" onclick="rejectInvoice('${inv.id}')">Reject</button>` : ''}
      </td>
    </tr>
  `).join('');
}

function renderCost() {
  const data = [
    { name: 'Classic Burger', price: 8.5, mat: 2.3, labor: 1.2, oh: 0.8 },
    { name: 'Cheese Burger', price: 10.5, mat: 3.1, labor: 1.2, oh: 0.8 },
    { name: 'Double Burger', price: 13.5, mat: 4.2, labor: 1.5, oh: 1.0 }
  ];
  document.getElementById('costBody').innerHTML = data.map(d => {
    const total = d.mat + d.labor + d.oh;
    const profit = d.price - total;
    const margin = ((profit / d.price) * 100).toFixed(1);
    return `<tr>
      <td>${d.name}</td><td>$${d.price.toFixed(2)}</td><td>$${d.mat.toFixed(2)}</td>
      <td>$${d.labor.toFixed(2)}</td><td>$${d.oh.toFixed(2)}</td>
      <td><b>$${total.toFixed(2)}</b></td>
      <td style="color:#27ae60">$${profit.toFixed(2)}</td>
      <td><span class="badge badge-ok">${margin}%</span></td>
    </tr>`;
  }).join('');
}

function renderEmployees() {
  const db = getDB();
  document.getElementById('employeeBody').innerHTML = db.employees.map(e => `
    <tr><td>${e.id}</td><td>${e.name}</td><td>${e.role}</td><td>${e.dept}</td>
    <td>$${e.wage}/hr</td><td>${e.hours}h</td>
    <td><span class="badge badge-ok">${e.status}</span></td></tr>
  `).join('');
}

// ============ Helpers ============
function formatItems(items) {
  const parts = [];
  if (items.classic) parts.push(`${items.classic}x Classic`);
  if (items.cheese) parts.push(`${items.cheese}x Cheese`);
  if (items.double) parts.push(`${items.double}x Double`);
  return parts.join(', ') || '-';
}

function statusBadge(status) {
  const map = { pending: 'badge-pending', processing: 'badge-processing', completed: 'badge-completed', cancelled: 'badge-cancelled', approved: 'badge-ok' };
  return `<span class="badge ${map[status] || 'badge-pending'}">${status.charAt(0).toUpperCase() + status.slice(1)}</span>`;
}

function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }

function openOrderModal() { openModal('orderModal'); }
function openProcurementModal() { openModal('procModal'); }

// ============ Business Actions ============
function createOrder() {
  const db = getDB();
  const customer = document.getElementById('ordCustomer').value || 'Walk-in';
  const channel = document.getElementById('ordChannel').value;
  const classic = parseInt(document.getElementById('ordClassic').value) || 0;
  const cheese = parseInt(document.getElementById('ordCheese').value) || 0;
  const double = parseInt(document.getElementById('ordDouble').value) || 0;
  if (classic + cheese + double === 0) { alert('Please order at least 1 burger!'); return; }
  const total = classic * 8.5 + cheese * 10.5 + double * 13.5;
  const newOrder = {
    id: 'ORD-' + String(db.nextOrderId++).padStart(3, '0'),
    customer, channel, items: { classic, cheese, double },
    total: parseFloat(total.toFixed(2)), status: 'pending', date: new Date().toISOString().slice(0, 10)
  };
  db.orders.unshift(newOrder);
  saveDB(db);
  closeModal('orderModal');
  renderAll();
  alert(`Order ${newOrder.id} created! Total: $${newOrder.total}`);
}

function approveOrder(id) {
  const db = getDB();
  const order = db.orders.find(o => o.id === id);
  if (order) {
    order.status = 'processing';
    // Auto-create production orders
    if (order.items.classic) createProd(db, 'Classic Burger', order.items.classic);
    if (order.items.cheese) createProd(db, 'Cheese Burger', order.items.cheese);
    if (order.items.double) createProd(db, 'Double Burger', order.items.double);
    saveDB(db);
    renderAll();
  }
}

function createProd(db, burger, qty) {
  // Check material availability
  const bom = {
    'Classic Burger': { Bun: 1, Patty: 1, Vegetable: 0.05, Sauce: 0.02 },
    'Cheese Burger': { Bun: 1, Patty: 1, Vegetable: 0.05, Sauce: 0.02, Cheese: 1 },
    'Double Burger': { Bun: 1, Patty: 2, Vegetable: 0.08, Sauce: 0.03, Cheese: 1 }
  };
  const needed = bom[burger] || {};
  let matOk = true;
  for (let mat in needed) {
    const inv = db.inventory.find(i => i.name === mat);
    if (inv && inv.stock < needed[mat] * qty) { matOk = false; break; }
  }
  db.production.unshift({
    id: 'PROD-' + String(db.nextProdId++).padStart(3, '0'),
    burger, qty, status: 'pending', materialCheck: matOk ? 'ok' : 'low'
  });
}

function startProduction(id) {
  const db = getDB();
  const p = db.production.find(x => x.id === id);
  if (p) {
    // Deduct materials
    const bom = {
      'Classic Burger': { Bun: 1, Patty: 1, Vegetable: 0.05, Sauce: 0.02 },
      'Cheese Burger': { Bun: 1, Patty: 1, Vegetable: 0.05, Sauce: 0.02, Cheese: 1 },
      'Double Burger': { Bun: 1, Patty: 2, Vegetable: 0.08, Sauce: 0.03, Cheese: 1 }
    };
    const needed = bom[p.burger] || {};
    for (let mat in needed) {
      const inv = db.inventory.find(i => i.name === mat);
      if (inv) inv.stock = parseFloat((inv.stock - needed[mat] * p.qty).toFixed(2));
    }
    p.status = 'processing';
    saveDB(db);
    renderAll();
  }
}

function finishProduction(id) {
  const db = getDB();
  const p = db.production.find(x => x.id === id);
  if (p) {
    p.status = 'completed';
    saveDB(db);
    renderAll();
  }
}

function completeOrder(id) {
  const db = getDB();
  const order = db.orders.find(o => o.id === id);
  if (order) {
    order.status = 'completed';
    saveDB(db);
    renderAll();
  }
}

function createProductionFromOrders() {
  alert('Production orders auto-generated when orders are approved.');
}

function createProcurement() {
  const db = getDB();
  const supplier = document.getElementById('procSupplier').value;
  const material = document.getElementById('procMaterial').value;
  const qty = parseInt(document.getElementById('procQty').value) || 100;
  const mat = db.inventory.find(i => i.name === material);
  const total = mat ? mat.price * qty : qty * 1;
  db.purchaseOrders.unshift({
    id: 'PO-' + String(db.nextPOId++).padStart(3, '0'),
    supplier, items: `${material} x ${qty}`, total: parseFloat(total.toFixed(2)), status: 'approved'
  });
  // Auto-create payable invoice
  db.invoices.unshift({
    id: 'INV-' + String(db.invoices.length + 1).padStart(3, '0'),
    type: 'Payable', party: supplier, amount: parseFloat(total.toFixed(2)), status: 'pending'
  });
  saveDB(db);
  closeModal('procModal');
  renderAll();
  alert(`PO created! $${total.toFixed(2)}`);
}

function receiveGoods(poId) {
  const db = getDB();
  const po = db.purchaseOrders.find(p => p.id === poId);
  if (po) {
    po.status = 'completed';
    // Parse items and add to inventory
    const match = po.items.match(/(\w+)\s*x\s*(\d+)/);
    if (match) {
      const matName = match[1];
      const qty = parseFloat(match[2]);
      const inv = db.inventory.find(i => i.name === matName);
      if (inv) inv.stock += qty;
    }
    saveDB(db);
    renderAll();
    alert('Goods received! Inventory updated.');
  }
}

function approveInvoice(id) {
  const db = getDB();
  const inv = db.invoices.find(i => i.id === id);
  if (inv) { inv.status = 'approved'; saveDB(db); renderAll(); }
}

function rejectInvoice(id) {
  const db = getDB();
  const inv = db.invoices.find(i => i.id === id);
  if (inv) { inv.status = 'cancelled'; saveDB(db); renderAll(); }
}

// Init
getDB();
</script>
</body>
</html>
